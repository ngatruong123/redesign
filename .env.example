# AI Provider
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-image

# Storage: Cloudflare R2 (leave empty for local filesystem)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=design-tool
R2_PUBLIC_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (NextAuth v5)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=user1@gmail.com,user2@gmail.com
