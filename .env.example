# Database
DATABASE_URL=postgresql://designtool:password@localhost:5432/designtool

# AI Provider (gemini, ideogram, mock — comma-separated for fallback chain)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-image-preview
IDEOGRAM_API_KEY=

# Storage: Cloudflare R2 (leave empty for local filesystem)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Background removal (rembg)
REMBG_PATH=/home/ngatruong/.local/bin/rembg
REMBG_MODEL=u2net

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encryption key for user settings (32 bytes hex = 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Auth
# AUTH_SECRET: signing key for JWT tokens (required in production)
AUTH_SECRET=change-me-to-a-random-string
# AUTH_PASSWORD: fallback password for env-based auth (required if not using DB)
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_TRUST_HOST=true

# CORS: comma-separated allowed origins for upload API
CORS_ALLOWED_ORIGINS=
